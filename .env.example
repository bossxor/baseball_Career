# Neon pooled connection for API runtime (project baseball_career, branch m3-dev)
DATABASE_URL=postgresql://Baseball_DB_owner:PASS@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/Baseball_DB?sslmode=require
# Direct (non-pooler) URL for schema apply / migrations
DATABASE_URL_DIRECT=postgresql://Baseball_DB_owner:PASS@ep-xxx.ap-southeast-1.aws.neon.tech/Baseball_DB?sslmode=require
PORT=3001
# Bind address (0.0.0.0 behind reverse proxy / remote; 127.0.0.1 local-only)
HOST=0.0.0.0
# Managed Better Auth base URL (m3-dev)
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.ap-southeast-1.aws.neon.tech/Baseball_DB/auth
# Local/PGlite tests only — never enable in production
# AUTH_MODE=dev

# --- Web / Android client (baked at Vite build) ---
# Must be https and non-local for Android: npm run build:android
VITE_API_BASE=https://api.againplayball.kr
VITE_AUTH_BASE=https://ep-xxx.neonauth.ap-southeast-1.aws.neon.tech/Baseball_DB/auth
# Optional local web only — never use for APK
# VITE_DEV_TOKEN=dev:local-web
