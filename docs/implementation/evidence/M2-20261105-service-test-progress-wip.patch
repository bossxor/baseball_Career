+test('M2-CLOSE-RETURN-20261102: a return-option US offer re-signs after two native service years; open service blocks it',()=>{
+ const closed=expired();closed.military.status='UNRESOLVED';
+ const source=openUsMinorMarket(closed,closed.revision,closed.inventory.clubs.map(o=>({organizationId:o.id,addedBudgetUsd:3_000_000}))),offer=source.minorMarket!.offers.find(o=>o.militaryReturnOption)!;
+ let c=requestUsAmateurReturn(source,source.revision);
+ for(let year=0;year<2;year++){
+  c=startUsAmateurReturnYear(c,c.revision,1);const limit=usServiceTestStepLimit(c.service!);let complete=false;
+  for(let i=0;i<limit;i++){const stamp=usServiceTestProgress(c.service!),next=advanceUsAmateurReturn(c,c.revision);c=next.career;assert.notEqual(next.stopReason,'ENGINE_LIMIT');assert.notEqual(usServiceTestProgress(c.service!),stamp,'native service command must advance a game or date');if(i%100===0)console.log('Native service progress',JSON.stringify({year:year+1,step:i,phase:c.service!.phaseContext.phase,recordRevision:c.service!.records.revision}));if(next.stopReason==='SEASON_COMPLETE'){complete=true;break;}}
+  assert.ok(complete,'actual service schedule must finish within its derived test bound');
+  c=settleUsAmateurReturnYear(c,c.revision);
+  if(year===0)assert.throws(()=>resignUsAfterAmateurReturn(c,c.revision,offer.offerKey),/OPTION_NOT_AVAILABLE/);
+ }
+ const us=resignUsAfterAmateurReturn(c,c.revision,offer.offerKey);
+ assert.equal(us.world.seasonKey,String(Number(source.world.seasonKey)+3));assert.equal(us.usAmateurReturn!.status,'CANCELLED_US');
+ const resumed=JSON.parse(JSON.stringify(us)) as typeof us;publishUsSeasonSchedule(confirmUsPreseasonPlan(resumed,resumed.revision),resumed.revision+1);
+});
